{
  "permissions": {
    "allow": [
      "LSP",
      "Bash(node .claude/skills/lookup/lookup.mjs *)",
      "Bash(node ../.claude/skills/lookup/lookup.mjs *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(gh run rerun *)",
      "Bash(gh run cancel *)",
      "Bash(gh release list *)",
      "Bash(gh release view *)",
      "Bash(gh repo view *)",
      "Bash(bash .claude/skills/sync/status.sh)",
      "Bash(node .claude/skills/plan-status/plan-status.mjs --check)",
      "Bash(node .claude/skills/plan-status/plan-status.mjs)",
      "Bash(npm test)",
      "Bash(npx tsc --noEmit -p .)",
      "Bash(npx tsc --noEmit -p tsconfig.json)",
      "Bash(npm run typecheck)",
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "mcp__ccd_pr__get_status",
      "mcp__ccd_session_mgmt__list_sessions",
      "mcp__terminal__read_terminal"
    ],
    "deny": [
      "Bash(gh pr merge * --admin*)",
      "Bash(gh pr merge --admin*)"
    ],
    "ask": [
      "Bash(gh release create *)",
      "Bash(gh release delete *)",
      "Bash(gh release edit *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/sync-check.mjs\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/lsp-nudge.mjs\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/wait-nudge.mjs\"",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-nudge.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/public-check.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  }
}
